class Forumer
{
    // ── Posting ───────────────────────────────────────────────────────────────
    // Every post is a signed envelope (forumer_core/post.h): signed by one of
    // the unlocked account's personas, with proof-of-work, and verified by
    // every receiver. Slots return "" on success or an error description.

    // New topic. `domains` is comma-separated user input ("privacy, campus")
    // and is normalised (max 3; "general" if none survive). `disclosure` is
    // "persona" | "alias" | "anonymous", or "" for the account default.
    SLOT(QString createTopic(QString title, QString body, QString domains, QString disclosure))

    // Reply to a topic (by its id). `disclosure` as above.
    SLOT(QString replyToTopic(QString topicId, QString body, QString disclosure))

    // Reply to any post — a topic or a reply — by its id. Threads are two
    // levels deep (forumer_core/thread.h): answering a topic makes a level-1
    // reply, answering a level-1 reply starts its sub-thread, and answering a
    // level-2 reply joins that same sub-thread.
    SLOT(QString replyToPost(QString postId, QString body, QString disclosure))

    // Every post already in the local store, as a JSON array ordered topics
    // first and oldest first within each kind:
    //   [{"kind":"topic","id":…,"title":…,"body":…,"author":…,"domains":…,"ts":…}, …]
    // Replies carry "topicId" and "parentId" (= topicId for level-1 replies).
    // `author` is the display form (fingerprint, alias, or "Anonymous").
    // Posts this device wrote also carry "state": "pending" | "sent" | "failed".
    //
    // A SLOT rather than a startup SIGNAL on purpose. The backend finishes its
    // bootstrap long before this view's replica has connected, and QtRO
    // forwards a signal only to replicas attached at the moment it is emitted
    // — there is no replay for a late joiner.
    SLOT(QString loadBacklog())

    // ── Sync ──────────────────────────────────────────────────────────────────
    // Posts travel on one content topic per forum; gaps are repaired by
    // digests (forumer_core/sync.h). Both run automatically — these are the
    // "do it now" buttons.

    // Send a digest now, so peers re-send any posts this device is missing.
    SLOT(QString catchUp())

    // Re-send every post of ours not yet confirmed, ignoring the retry backoff.
    SLOT(QString retryUnsent())

    // ── Identity ──────────────────────────────────────────────────────────────
    // Accounts are master secrets kept in password-protected vaults on this
    // device (forumer_core/account_store.h). Exactly one may be unlocked; its
    // personas sign posts.

    // Create a new account and unlock it. Returns JSON:
    //   {"error": ""} plus {"phrase": "24 words…"} on success.
    // The phrase is shown once for the user to write down.
    SLOT(QString createIdentity(QString label, QString password))

    // Unlock an existing account. "" on success.
    SLOT(QString unlockIdentity(QString accountId, QString password))

    // Rebuild an account from its recovery phrase under a new password, and
    // unlock it. Also the "forgot my password" path. "" on success.
    SLOT(QString restoreIdentity(QString phrase, QString label, QString password))

    // Lock the current account (forget its secret from memory).
    SLOT(QString lockIdentity())

    // Make another account the one offered for unlock. Locks the current one.
    SLOT(QString selectAccount(QString accountId))

    // Show the recovery phrase again. Returns JSON {"error": "", "phrase": "…"}.
    SLOT(QString revealPhrase(QString password))

    SLOT(QString changePassword(QString oldPassword, QString newPassword))
    SLOT(QString renameAccount(QString label))

    // Remove the unlocked account from this device (password re-entered as
    // confirmation). Irreversible without the recovery phrase.
    SLOT(QString deleteAccount(QString password))

    // ── Persona controls ──────────────────────────────────────────────────────
    SLOT(QString rotatePersona())                       // "Rotate now"
    SLOT(QString chooseRotationPolicy(QString policy))  // "keep" | "manual" | "auto"
    SLOT(QString chooseDefaultDisclosure(QString disclosure))
    SLOT(QString chooseAlias(QString alias))

    // Followed domains, saved with the unlocked account. The name is
    // normalised the way post domains are ("Campus Life" -> "campus-life").
    SLOT(QString followDomain(QString domain))
    SLOT(QString unfollowDomain(QString domain))

    // ── State (auto-synced to the view) ───────────────────────────────────────
    // Human-readable node/connection status.
    PROP(QString status="Starting…" READONLY)

    // True once the local store is open (composing works offline).
    PROP(bool nodeReady=false READONLY)

    // The content topic this forum runs on (for display).
    PROP(QString topic="" READONLY)

    // Posts of ours not yet confirmed by the network (pending or failed).
    PROP(int unsentCount=0 READONLY)

    // One line about sync for the status bar, e.g. "synced 14:02 · 3 recovered".
    PROP(QString syncInfo="" READONLY)

    // App version, from metadata.json.
    PROP(QString appVersion="" READONLY)

    // "none" (no account on this device yet) | "locked" | "unlocked".
    PROP(QString identityState="none" READONLY)

    // Accounts on this device: [{"id":"…","label":"…"}, …], oldest first.
    PROP(QString accountsJson="[]" READONLY)

    // The account offered for unlock / currently unlocked.
    PROP(QString selectedAccountId="" READONLY)
    PROP(QString myLabel="" READONLY)

    // Fingerprint of the persona Keep/Manual post as, e.g. "fr:7Q4K-M2XD".
    // Empty while locked.
    PROP(QString myPersona="" READONLY)

    PROP(QString rotationPolicy="manual" READONLY)
    PROP(QString defaultDisclosure="persona" READONLY)
    PROP(QString alias="" READONLY)

    // The unlocked account's followed domains: ["privacy", "campus", …].
    PROP(QString followedDomains="[]" READONLY)

    // ── Events ────────────────────────────────────────────────────────────────
    // A verified topic arrived (or was just created locally). `author` is the
    // display form; `domains` comma-separated; `timestamp` ns since epoch
    // (the author's clock).
    SIGNAL(topicReceived(QString id, QString title, QString body, QString author, QString domains, qint64 timestamp))

    // A verified reply in topic `topicId`, answering `parentId` (the topic
    // itself for a level-1 reply, a level-1 reply for a level-2 one).
    SIGNAL(replyReceived(QString id, QString topicId, QString parentId, QString body, QString author, qint64 timestamp))

    // Delivery state of a post *this* install made: "pending", "propagated",
    // "sent" or "failed" (reason in `detail`). Failed posts stay in the outbox
    // and are retried automatically, so "failed" can later become "sent".
    SIGNAL(messageStateChanged(QString id, QString state, QString detail))
}
