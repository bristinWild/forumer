{
  "name": "forumer",
  "display_name": "Forumer",
  "version": "0.2.2",
  "type": "ui_qml",
  "interface": "universal",
  "category": "social",
  "description": "A private forum with no server: topics, threads and domains over Logos Delivery (Waku), history from peers and the network's store nodes, and posts signed as a persona, under an alias, or anonymously.",
  "main": "forumer_plugin",
  "icon": "assets/icon.png",
  "view": "qml/Main.qml",
  "dependencies": [
    {
      "name": "delivery_module",
      "version": "~0.3.0"
    },
    {
      "name": "storage_module",
      "version": "~3.0.0"
    }
  ],
  "provides": [
    {
      "intent": "forumer.open",
      "web": true,
      "params": [
        {
          "name": "topic",
          "type": "string",
          "required": false
        },
        {
          "name": "day",
          "type": "number",
          "required": false
        },
        {
          "name": "domain",
          "type": "string",
          "required": false
        }
      ]
    }
  ],
  "codegen": {
    "rep": "src/forumer.rep"
  },
  "nix": {
    "packages": {
      "build": [
        "sqlite",
        "libsodium"
      ],
      "runtime": [
        "sqlite",
        "nlohmann_json",
        "libsodium"
      ]
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [
        "SQLite3"
      ],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": [
        "SQLite::SQLite3"
      ]
    }
  }
}