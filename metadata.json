{
  "name": "forumer",
  "display_name": "Forumer",
  "version": "0.1.0",
  "type": "ui_qml",
  "interface": "universal",
  "category": "example",
  "description": "Forumer: a private, serverless forum on the Logos stack. Personas, identity rotation, offline catch-up and an outbox.",
  "main": "forumer_plugin",
  "icon": null,
  "view": "qml/Main.qml",
  "dependencies": [
    "delivery_module",
    "storage_module"
  ],
  "provides": [
    {
      "intent": "forumer.open",
      "web": true,
      "params": [
        {
          "name": "topic",
          "type": "string",
          "required": false
        },
        {
          "name": "day",
          "type": "number",
          "required": false
        },
        {
          "name": "domain",
          "type": "string",
          "required": false
        }
      ]
    }
  ],
  "codegen": {
    "rep": "src/forumer.rep"
  },
  "nix": {
    "packages": {
      "build": [
        "sqlite",
        "libsodium"
      ],
      "runtime": [
        "sqlite",
        "nlohmann_json",
        "libsodium"
      ]
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": [
        "SQLite3"
      ],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": [
        "SQLite::SQLite3"
      ]
    }
  }
}
